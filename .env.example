# Copy to .env and fill in. .env is gitignored; never commit a real key.
OPENROUTER_API_KEY=sk-or-...

# Optional. Free model ids change — check https://openrouter.ai/models?q=free
# AIFLOW_MODEL=minimax/minimax-m3:free

# Optional. Default 50, matching the free tier.
# AIFLOW_DAILY_LIMIT=50

# Optional. Where the call ledger and response cache live. Default ~/.aiflow
# AIFLOW_HOME=~/.aiflow
